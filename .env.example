# ==============================================================================
# EscrowMind: Unified Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND ENVIRONMENT VARIABLES (apps/api/.env)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
APP_URL=http://localhost:8080

# PayPal REST API Configuration (Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# AI & LLM Services
OPENAI_API_KEY=your_openai_api_key_here

# Headless Browser Verification Agent
KERNEL_API_KEY=your_kernel_api_key_here

# Supabase (PostgreSQL & Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Render Workflows Orchestration
RENDER_WORKFLOW_TOKEN=your_render_workflow_token
INTERNAL_WORKFLOW_SECRET=generate_a_long_random_secret_string_here

# Escrow Fiduciary Guardrails & Policy
AUTO_APPROVE_THRESHOLD=80
MANUAL_REVIEW_THRESHOLD=50
MAX_PROJECT_DAYS=20
MAX_AUTO_APPROVE_AMOUNT=500.00

# Platform Fee Policy (Set to 0 for exact 1:1 demo capture-to-payout matching)
PLATFORM_FEE_PERCENT=0

# Local Development / Zero-Dependency Testing Mocks
# Set these to 'true' to run end-to-end tests without consuming paid API quotas
MOCK_AI=false
MOCK_KERNEL=false
DEV_SKIP_VERIFY=false

# ------------------------------------------------------------------------------
# 2. FRONTEND ENVIRONMENT VARIABLES (apps/web/.env.local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
